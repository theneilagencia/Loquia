# Loquia — environment variable NAMES only (never commit real values).

# --- API (apps/api) ---
NODE_ENV=development
DATABASE_URL=postgres://postgres@127.0.0.1:5433/loquia
SESSION_SECRET=
APP_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=4000
# Optional: restrict cookie domain in production
COOKIE_DOMAIN=
RATE_LIMIT_MAX=100

# --- API integration tests ---
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/loquia_test

# --- Web (apps/web) ---
# 'api' uses the real backend (ApiAdapter); 'mock' uses the in-browser MockAdapter.
NEXT_PUBLIC_APP_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Media pipeline: queue (Render Key Value / Redis) ---
# Shared by the API (producer) and the worker (consumer). Empty in dev disables
# the queue (enqueue is a no-op).
REDIS_URL=redis://127.0.0.1:6380

# --- Media pipeline: object storage ---
# STORAGE_PROVIDER: r2 | mock. Unset → r2 if R2_* present, else mock (dev only;
# production must set r2 with credentials, or mock explicitly).
STORAGE_PROVIDER=mock
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Filesystem dir used by the mock storage adapter.
MEDIA_MOCK_DIR=/tmp/loquia-media
# Public base URL of the API (mock storage callbacks / worker download base).
PUBLIC_API_URL=http://localhost:4000

# --- Media pipeline: transcription ---
# TRANSCRIPTION_PROVIDER: deepgram | mock. Unset → deepgram if DEEPGRAM_API_KEY
# present, else mock (dev only; production must be explicit).
TRANSCRIPTION_PROVIDER=mock
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# --- AI Pack generation (Milestone 4) ---
# AI_PACK_PROVIDER: anthropic | mock. Unset → anthropic if ANTHROPIC_API_KEY
# present, else mock (dev only; production must be explicit).
AI_PACK_PROVIDER=mock
AI_PACK_MODEL=claude-sonnet-5
AI_PACK_MAX_RETRIES=2
ANTHROPIC_API_KEY=

# --- Media pipeline: limits / TTLs ---
MAX_UPLOAD_SIZE_BYTES=524288000
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_DOWNLOAD_URL_TTL_SECONDS=3600

# --- Transactional email (Milestone 5) ---
# EMAIL_PROVIDER: resend | console. Unset → resend if EMAIL_API_KEY present, else
# console. console is DEV/TEST ONLY — production must set resend with a key;
# there is no silent fallback to console in production.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
# Verified sender, e.g. "Loquia <no-reply@yourdomain.com>".
EMAIL_FROM=
EMAIL_REPLY_TO=
# Password reset token lifetime (minutes).
PASSWORD_RESET_TTL_MINUTES=60

# --- Operational quotas (Milestone 5; protection, not billing) ---
MAX_MEETING_DURATION_SECONDS=14400
MAX_ACTIVE_PROCESSING_JOBS_PER_WORKSPACE=20
MAX_AI_PACK_REGENERATIONS_PER_HOUR=10

# --- Retention (Milestone 5) ---
# Legacy under Local First (remote copy is temporary); only affects pre-Local-First rows.
MEDIA_RETENTION_DAYS=0
# Local First safety net: max hours a temporary remote processing copy may live before
# the cleanup sweep force-deletes it. Mirror this in the R2 bucket lifecycle rule.
REMOTE_MEDIA_MAX_TTL_HOURS=24

# --- Security ---
# Comma-separated CORS allowlist; defaults to APP_URL when unset.
CORS_ORIGINS=
