{
  "name": "@loquia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loquia backend — Fastify + Drizzle + PostgreSQL (Milestone 2 foundation).",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema.ts",
    "./env": "./src/env.ts",
    "./jobs": "./src/services/ai-pack-runner.ts",
    "./lib/crypto": "./src/lib/crypto.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/db/seed.ts",
    "smoke:production": "tsx scripts/smoke-production.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/rate-limit": "10.2.2",
    "@loquia/contracts": "workspace:*",
    "@loquia/domain": "workspace:*",
    "@loquia/pipeline": "workspace:*",
    "bullmq": "5.34.10",
    "drizzle-orm": "0.38.4",
    "fastify": "5.2.1",
    "postgres": "3.4.5",
    "tsx": "4.19.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "drizzle-kit": "0.30.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
